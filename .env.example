# Copy to .env and adjust. Every application variable below is required; the app
# will not start if one is missing, empty (except TRACE_DIR) or malformed.

# Database (matches docker-compose.yaml)
DATABASE_URL=postgresql://rag-cli:password@localhost:5432/rag-cli
# Optional pytest override; defaults to the isolated pgvector-test service.
TEST_DATABASE_URL=postgresql://rag-cli:rag-cli@localhost:5433/sourceTraceTest

# Models
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Retrieval
CANDIDATE_K=50
CONTEXT_N=10
# Number of neighboring chunks to include on each side of a selected child.
PARENT_CHUNK_RADIUS=2
USE_RERANKER=true
USE_QUERY_TRANSFORM=false

# Ingestion
CHUNK_SIZE=512
CHUNK_OVERLAP=50
EMBED_BATCH_SIZE=64
EMBED_MAX_RETRIES=3

# Observability
# PRINT_TRACE=true prints a per-request stage/latency summary
# TRACE_DIR=traces writes one JSON trace file per chat turn / ingested file (empty = off)
PRINT_TRACE=false
TRACE_DIR=

# Failure injection: simulate a stage outage to exercise graceful degradation.
FORCE_RERANKER_FAILURE=false
FORCE_KEYWORD_FAILURE=false
FORCE_SEMANTIC_FAILURE=false
